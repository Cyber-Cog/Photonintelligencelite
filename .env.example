# Copy to .env for local Docker Compose use. Only deployment limits are env-overridable —
# algorithm thresholds live in analytics/config/*.yaml (see docs/architecture_decisions.md §6).
# Cloud (Neon/Render/Vercel): set the same keys in dashboards — see docs/deployment.md + render.yaml.
# Neon may give postgresql://… — the API accepts that and normalizes to postgresql+psycopg://.

DATABASE_URL=postgresql+psycopg://pic_lite:pic_lite@db:5432/pic_lite
JOB_ROOT=/srv/uploads
PIC_LITE_FREE_TIER=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Auth (see docs/AUTH.md)
SESSION_SECRET=change-me-in-production
SESSION_TTL_DAYS=14
# Local HTTP: false → SameSite=Lax. Render (HTTPS + Vercel UI): true → SameSite=None; Secure
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:5173
AUTH_AUTO_VERIFY=true
# Superadmin seed (see docs/AUTH.md). Lab .local emails are accepted by auth schemas.
# PIC_SUPERADMIN_EMAIL=admin@pic.local
# PIC_SUPERADMIN_PASSWORD=admin12345
# Or: PIC_SUPERADMIN_EMAIL=admin@example.com
# PIC_SUPERADMIN_PASSWORD=choose-a-strong-password
# PIC_SUPERADMIN_NAME=Superadmin

# Optional SMTP — without it, verification/reset links are logged and returned in API responses
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true

# Deployment limit overrides (optional — defaults come from analytics/config/defaults.yaml)
# MAX_COMPRESSED_UPLOAD_MB=100
# MAX_DECOMPRESSED_UPLOAD_MB=250
# JOB_TIMEOUT_SEC=900
# Completed-job result retention (minutes). Default 10080 = 7 days. Was historically 60.
# REPORT_TTL_MINUTES=10080
# Concurrent analysis workers (default 4 locally; use 1 on Render free tier — set in render.yaml).
# MAX_CONCURRENT_JOBS=4

# Google Gemini / AI Studio (preferred — server-side only).
# Create at https://aistudio.google.com/apikey → paste into THIS repo's gitignored `.env`.
# Never put this key in frontend / Vercel VITE_* env vars.
# Production: Render → pic-lite-api → Environment → GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_TIMEOUT_SEC=45

# ZenMux (optional fallback when GEMINI_API_KEY is unset) — fault-run / upload AI integrity.
# REQUIRED for ZenMux path: a CHAT key. Full click-path: docs/ZENMUX-API-SETUP.md
#
#   Create here → paste into THIS repo's gitignored `.env` as ZENMUX_API_KEY=
#     • Local/dev:  https://zenmux.ai/platform/subscription  → key starts with sk-ss-v1-
#     • Production: https://zenmux.ai/platform/pay-as-you-go → key starts with sk-ai-v1-
#                   (top up if PAYG balance is $0)
#
#   WRONG: sk-mg-v1-… (Management key) → HTTP 403 on chat completions. Do not use it here.
#   Never put this key in frontend / Vercel VITE_* env vars.
#   Production: Render → pic-lite-api → Environment → ZENMUX_API_KEY (same value).
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_MODEL=google/gemini-2.5-flash
# ZENMUX_TIMEOUT_SEC=45

# Frontend (Vite) — see frontend/.env.example
# Local: VITE_API_BASE_URL=http://localhost:8000 (or empty to use Vite /api proxy)
# Vercel: leave unset — same-origin /api is rewritten to the Render API (vercel.json).
# VITE_API_BASE_URL=http://localhost:8000
